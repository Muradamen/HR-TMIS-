<nav class="app-header navbar navbar-expand bg-body">
  <div class="container-fluid">
    <ul class="navbar-nav">
      <li class="nav-item">
        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
          <i class="bi bi-list fs-5"></i>
        </a>
      </li>
      <li class="nav-item d-none d-md-block">
        <a href="/dashboard" class="nav-link fw-semibold text-success">
          <i class="bi bi-building-check me-1"></i> Harari Region Trade & Industry Bureau
        </a>
      </li>
    </ul>

    <ul class="navbar-nav ms-auto align-items-center gap-2">
      <!-- Role Badge -->
      <li class="nav-item">
        <% if (user.role === 'DATA_ENCODER') { %>
          <span class="badge bg-primary px-3 py-2 fs-7"><i class="bi bi-input-cursor-text me-1"></i> Data Encoder</span>
        <% } else if (user.role === 'DIRECTOR_OF_TRADER_CONTROL') { %>
          <span class="badge bg-success px-3 py-2 fs-7"><i class="bi bi-clipboard-check me-1"></i> Director of Trader Control</span>
        <% } else if (user.role === 'ADMINISTRATOR') { %>
          <span class="badge bg-dark px-3 py-2 fs-7"><i class="bi bi-shield-lock me-1"></i> Administrator</span>
        <% } else { %>
          <span class="badge bg-warning text-dark px-3 py-2 fs-7"><i class="bi bi-award me-1"></i> Agency Leader</span>
        <% } %>
      </li>

      <!-- Quick Register Action (for Encoders & Admins) -->
      <% if (user.role === 'DATA_ENCODER' || user.role === 'ADMINISTRATOR') { %>
        <li class="nav-item">
          <a href="/traders/register/" class="btn btn-sm btn-success text-white px-3 shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Register Trader
          </a>
        </li>
      <% } %>

      <!-- Role Switcher for Testing -->
      <li class="nav-item dropdown">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-arrow-repeat text-secondary"></i>
          <span class="d-none d-sm-inline">Switch Role</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow">
          <li class="dropdown-header">Switch Logged-in Role</li>
          <li>
            <a class="dropdown-item py-1 <%= user.role === 'DATA_ENCODER' ? 'active' : '' %>" href="/api/switch-user?user=encoder">
              <i class="bi bi-input-cursor-text me-2 text-primary"></i> Data Encoder (Dawit)
            </a>
          </li>
          <li>
            <a class="dropdown-item py-1 <%= user.role === 'DIRECTOR_OF_TRADER_CONTROL' ? 'active' : '' %>" href="/api/switch-user?user=director">
              <i class="bi bi-clipboard-check me-2 text-success"></i> Director of Control (Tigist)
            </a>
          </li>
          <li>
            <a class="dropdown-item py-1 <%= user.role === 'ADMINISTRATOR' ? 'active' : '' %>" href="/api/switch-user?user=admin">
              <i class="bi bi-gear-fill me-2 text-dark"></i> Administrator (Murad)
            </a>
          </li>
          <li>
            <a class="dropdown-item py-1 <%= user.role === 'AGENCY_LEADER' ? 'active' : '' %>" href="/api/switch-user?user=leader">
              <i class="bi bi-award-fill me-2 text-warning"></i> Agency Leader (Yusuf)
            </a>
          </li>
        </ul>
      </li>

      <!-- User Profile & Logout -->
      <li class="nav-item d-flex align-items-center ms-2 border-start ps-3 gap-2">
        <span class="small fw-semibold text-secondary d-none d-md-inline">
          <%= user.first_name %> <%= user.last_name %>
        </span>
        <a href="/logout" class="btn btn-sm btn-outline-danger py-1 px-2" title="Sign Out">
          <i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Logout</span>
        </a>
      </li>
    </ul>
  </div>
</nav>
