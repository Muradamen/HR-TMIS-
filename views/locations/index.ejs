<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Locations - Woredas & Kebeles' }) %>
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
  <div class="app-wrapper">
    <%- include('../partials/navbar') %>
    <%- include('../partials/sidebar', { activeNav: 'locations', activeSubNav: '' }) %>

    <main class="app-main">
      <div class="app-content-header py-3 bg-body border-bottom mb-4">
        <div class="container-fluid">
          <div class="row align-items-center g-2">
            <div class="col-sm-6">
              <h3 class="mb-0 fw-bold text-body">
                <i class="bi bi-geo-alt-fill text-danger me-2"></i>Harari Region Administrative Locations
              </h3>
              <p class="text-muted small mb-0">Woredas and Kebeles governing municipal and trade jurisdictions</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
              <a href="/traders/" class="btn btn-outline-primary">
                <i class="bi bi-people me-1"></i> View Registered Traders
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="app-content">
        <div class="container-fluid">
          <div class="row g-4">
            <% woredas.forEach(w => { %>
              <div class="col-12 col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                  <div class="card-header bg-body py-3 d-flex justify-content-between align-items-center">
                    <div>
                      <h5 class="fw-bold mb-0 text-success"><%= w.name %></h5>
                      <small class="text-muted font-monospace">Code: <%= w.code %></small>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                  </div>
                  <div class="card-body p-3">
                    <h6 class="small text-uppercase text-muted fw-semibold mb-2">Registered Kebeles:</h6>
                    <ul class="list-group list-group-flush small">
                      <% const woredaKebeles = kebeles.filter(k => k.woreda_id === w.id); %>
                      <% if (woredaKebeles.length === 0) { %>
                        <li class="list-group-item px-0 text-muted fst-italic">No kebeles registered</li>
                      <% } else { %>
                        <% woredaKebeles.forEach(k => { %>
                          <li class="list-group-item px-0 py-1 d-flex justify-content-between">
                            <span><i class="bi bi-dot text-success"></i><%= k.name %></span>
                            <span class="font-monospace text-muted small"><%= k.code %></span>
                          </li>
                        <% }); %>
                      <% } %>
                    </ul>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>
