<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Traders Registry' }) %>
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
  <div class="app-wrapper">
    <%- include('../partials/navbar') %>
    <%- include('../partials/sidebar', { activeNav: 'traders', activeSubNav: '' }) %>

    <main class="app-main">
      <div class="app-content-header py-3 bg-white border-bottom mb-4">
        <div class="container-fluid">
          <div class="row align-items-center">
            <div class="col-sm-6">
              <h3 class="mb-0 fw-bold text-dark">
                <i class="bi bi-people-fill text-primary me-2"></i>Traders Registry
              </h3>
              <p class="text-muted small mb-0">Official registry of formal businesses and surveyed informal enterprises</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0 d-flex justify-content-sm-end gap-2">
              <!-- Export Buttons -->
              <a href="/traders/export/excel?<%= queryString %>" class="btn btn-outline-success shadow-sm" title="Export current search results to Excel (.xlsx)">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Excel (.xlsx)
              </a>
              <a href="/traders/export/pdf?<%= queryString %>" class="btn btn-outline-danger shadow-sm" title="Export current search results to PDF">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> PDF Report
              </a>
              <% if (user.role === 'DATA_ENCODER' || user.role === 'ADMINISTRATOR') { %>
                <a href="/traders/register/" class="btn btn-success shadow-sm">
                  <i class="bi bi-plus-lg me-1"></i> Register Trader
                </a>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="app-content">
        <div class="container-fluid">

          <!-- Flash Message Notification -->
          <% if (typeof flashMessage !== 'undefined' && flashMessage) { %>
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
              <i class="bi bi-check-circle-fill me-2"></i><%= flashMessage %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <!-- Search & Filter Card -->
          <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
              <form action="/traders/" method="GET" class="row g-2 align-items-center">
                <div class="col-12 col-md-3">
                  <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                      <i class="bi bi-search text-muted"></i>
                    </span>
                    <input
                      type="text"
                      name="query"
                      class="form-control border-start-0"
                      placeholder="Search Code, Name, TIN, Phone..."
                      value="<%= filters.query || '' %>"
                    />
                  </div>
                </div>

                <div class="col-6 col-md-2">
                  <select name="type" class="form-select">
                    <option value="ALL" <%= filters.type === 'ALL' ? 'selected' : '' %>>All Types</option>
                    <option value="LEGAL" <%= filters.type === 'LEGAL' ? 'selected' : '' %>>Legal Trader</option>
                    <option value="INFORMAL" <%= filters.type === 'INFORMAL' ? 'selected' : '' %>>Informal Trader</option>
                  </select>
                </div>

                <div class="col-6 col-md-2">
                  <select name="status" class="form-select">
                    <option value="ALL" <%= filters.status === 'ALL' ? 'selected' : '' %>>All Statuses</option>
                    <option value="DRAFT" <%= filters.status === 'DRAFT' ? 'selected' : '' %>>Draft</option>
                    <option value="SUBMITTED" <%= filters.status === 'SUBMITTED' ? 'selected' : '' %>>Submitted</option>
                    <option value="UNDER_REVIEW" <%= filters.status === 'UNDER_REVIEW' ? 'selected' : '' %>>Under Review</option>
                    <option value="APPROVED" <%= filters.status === 'APPROVED' ? 'selected' : '' %>>Approved</option>
                    <option value="NEEDS_CORRECTION" <%= filters.status === 'NEEDS_CORRECTION' ? 'selected' : '' %>>Needs Correction</option>
                    <option value="REJECTED" <%= filters.status === 'REJECTED' ? 'selected' : '' %>>Rejected</option>
                    <option value="ARCHIVED" <%= filters.status === 'ARCHIVED' ? 'selected' : '' %>>Archived</option>
                  </select>
                </div>

                <div class="col-6 col-md-2">
                  <select name="woreda_id" class="form-select" id="filter_woreda">
                    <option value="">All Woredas</option>
                    <% woredas.forEach(w => { %>
                      <option value="<%= w.id %>" <%= Number(filters.woreda_id) === w.id ? 'selected' : '' %>>
                        <%= w.name %>
                      </option>
                    <% }); %>
                  </select>
                </div>

                <div class="col-6 col-md-2">
                  <select name="sector" class="form-select">
                    <option value="ALL" <%= filters.sector === 'ALL' ? 'selected' : '' %>>All Sectors</option>
                    <option value="GENERAL_TRADE" <%= filters.sector === 'GENERAL_TRADE' ? 'selected' : '' %>>General Trade</option>
                    <option value="RETAIL_WHOLESALE_GOODS" <%= filters.sector === 'RETAIL_WHOLESALE_GOODS' ? 'selected' : '' %>>Retail/Wholesale</option>
                    <option value="AGRICULTURE_AGRO_PROCESSING" <%= filters.sector === 'AGRICULTURE_AGRO_PROCESSING' ? 'selected' : '' %>>Agriculture</option>
                    <option value="MANUFACTURING_PRODUCTION" <%= filters.sector === 'MANUFACTURING_PRODUCTION' ? 'selected' : '' %>>Manufacturing</option>
                    <option value="SERVICE_PROVIDER" <%= filters.sector === 'SERVICE_PROVIDER' ? 'selected' : '' %>>Service Provider</option>
                    <option value="STREET_VENDING_OPEN_MARKET" <%= filters.sector === 'STREET_VENDING_OPEN_MARKET' ? 'selected' : '' %>>Street Vending</option>
                    <option value="PETTY_RETAIL" <%= filters.sector === 'PETTY_RETAIL' ? 'selected' : '' %>>Petty Retail</option>
                  </select>
                </div>

                <div class="col-12 col-md-1 d-flex gap-1">
                  <button type="submit" class="btn btn-primary w-100" title="Apply Filter">
                    <i class="bi bi-funnel-fill"></i>
                  </button>
                  <a href="/traders/" class="btn btn-outline-secondary" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                  </a>
                </div>
              </form>
            </div>
          </div>

          <!-- Traders List Table Card -->
          <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
              <h5 class="card-title fw-bold mb-0">
                Found <%= totalCount %> <%= totalCount === 1 ? 'Trader' : 'Traders' %>
                <span class="small text-muted fw-normal">
                  (Showing page <%= currentPage %> of <%= totalPages || 1 %>)
                </span>
              </h5>
              <div class="small text-muted">
                Standard pagination: <strong>25 records / page</strong>
              </div>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th style="width: 150px;">Trader Code</th>
                      <th>Trader / Entity Name</th>
                      <th>Type</th>
                      <th>Sector / Activity</th>
                      <th>Woreda & Kebele</th>
                      <th>Status</th>
                      <th>Registered</th>
                      <th class="text-end" style="width: 120px;">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (traders.length === 0) { %>
                      <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                          <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                          No traders found matching your criteria.
                          <div class="mt-2">
                            <a href="/traders/" class="btn btn-sm btn-outline-secondary">Reset Search Filters</a>
                          </div>
                        </td>
                      </tr>
                    <% } else { %>
                      <% traders.forEach(trader => { %>
                        <tr>
                          <td>
                            <a href="/traders/<%= trader.trader_code %>/" class="fw-bold font-monospace text-decoration-none">
                              <%= trader.trader_code %>
                            </a>
                          </td>
                          <td>
                            <div class="fw-semibold"><%= trader.displayName %></div>
                            <div class="small text-muted">
                              <% if (trader.trader_type === 'LEGAL') { %>
                                TIN: <%= trader.legal_details.tin %> &bull; Lic: <%= trader.legal_details.trade_license_number || 'N/A' %>
                              <% } else { %>
                                Contact: <%= trader.informal_details.phone_number || 'N/A' %> &bull; Location: <%= trader.informal_details.specific_location_market_area %>
                              <% } %>
                            </div>
                          </td>
                          <td>
                            <% if (trader.trader_type === 'LEGAL') { %>
                              <span class="badge badge-legal"><i class="bi bi-patch-check me-1"></i>Legal</span>
                            <% } else { %>
                              <span class="badge badge-informal"><i class="bi bi-person-badge me-1"></i>Informal</span>
                            <% } %>
                          </td>
                          <td>
                            <% if (trader.trader_type === 'LEGAL') { %>
                              <span class="badge bg-light text-dark border">
                                <%= trader.legal_details.business_sector.replace(/_/g, ' ') %>
                              </span>
                              <div class="small text-muted"><%= trader.legal_details.trade_scale %></div>
                            <% } else { %>
                              <span class="badge bg-light text-dark border">
                                <%= trader.informal_details.nature_of_trade_activity.replace(/_/g, ' ') %>
                              </span>
                              <div class="small text-muted"><%= trader.informal_details.formalization_status_recommendation.replace(/_/g, ' ') %></div>
                            <% } %>
                          </td>
                          <td>
                            <div class="fw-medium"><%= trader.woredaName %></div>
                            <small class="text-muted"><%= trader.kebeleName %></small>
                          </td>
                          <td>
                            <% if (trader.status === 'APPROVED') { %>
                              <span class="badge badge-approved">Approved</span>
                            <% } else if (trader.status === 'SUBMITTED') { %>
                              <span class="badge bg-primary">Submitted</span>
                            <% } else if (trader.status === 'UNDER_REVIEW') { %>
                              <span class="badge bg-warning text-dark">Under Review</span>
                            <% } else if (trader.status === 'NEEDS_CORRECTION') { %>
                              <span class="badge bg-danger">Needs Correction</span>
                            <% } else if (trader.status === 'DRAFT') { %>
                              <span class="badge bg-secondary">Draft</span>
                            <% } else if (trader.status === 'REJECTED') { %>
                              <span class="badge bg-dark">Rejected</span>
                            <% } else { %>
                              <span class="badge bg-secondary"><%= trader.status %></span>
                            <% } %>
                          </td>
                          <td>
                            <small class="text-muted"><%= trader.created_at.substring(0, 10) %></small>
                            <div class="small text-muted" style="font-size: 0.7rem;"><%= trader.registered_by %></div>
                          </td>
                          <td class="text-end">
                            <a href="/traders/<%= trader.trader_code %>/" class="btn btn-sm btn-outline-primary" title="View Dossier">
                              <i class="bi bi-eye"></i> View
                            </a>
                          </td>
                        </tr>
                      <% }); %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- 25 Records / Page Pagination Controls -->
            <% if (totalPages > 1) { %>
              <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
                <div class="small text-muted">
                  Showing records <strong><%= (currentPage - 1) * 25 + 1 %></strong> to <strong><%= Math.min(currentPage * 25, totalCount) %></strong> of <strong><%= totalCount %></strong>
                </div>

                <nav aria-label="Page navigation">
                  <ul class="pagination pagination-sm mb-0">
                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                      <a class="page-link" href="/traders/?<%= paginationQuery %>&page=<%= currentPage - 1 %>">Previous</a>
                    </li>

                    <% for (let p = 1; p <= totalPages; p++) { %>
                      <li class="page-item <%= currentPage === p ? 'active' : '' %>">
                        <a class="page-link" href="/traders/?<%= paginationQuery %>&page=<%= p %>"><%= p %></a>
                      </li>
                    <% } %>

                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                      <a class="page-link" href="/traders/?<%= paginationQuery %>&page=<%= currentPage + 1 %>">Next</a>
                    </li>
                  </ul>
                </nav>
              </div>
            <% } %>
          </div>

        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>
