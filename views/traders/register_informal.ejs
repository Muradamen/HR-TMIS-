<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Register Informal Trader' }) %>
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
  <div class="app-wrapper">
    <%- include('../partials/navbar') %>
    <%- include('../partials/sidebar', { activeNav: 'register', activeSubNav: 'register_informal' }) %>

    <main class="app-main">
      <div class="app-content-header py-3 bg-white border-bottom mb-4">
        <div class="container-fluid">
          <div class="row align-items-center">
            <div class="col-sm-7">
              <h3 class="mb-0 fw-bold text-dark">
                <i class="bi bi-person-lines-fill text-warning me-2"></i>Informal Trader Enumeration & Assessment
              </h3>
              <p class="text-muted small mb-0">Survey informal operators, open-market vendors, and record formalization recommendations</p>
            </div>
            <div class="col-sm-5 text-sm-end mt-2 mt-sm-0">
              <a href="/traders/register/" class="btn btn-outline-secondary me-1">
                <i class="bi bi-arrow-left me-1"></i> Category Choice
              </a>
              <a href="/traders/" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle me-1"></i> Cancel
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="app-content">
        <div class="container-fluid">
          <div class="row justify-content-center">
            <div class="col-xl-10">

              <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                  <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% } %>

              <form action="/traders/register/informal/" method="POST" class="needs-validation">
                <!-- Section 1: Personal Identification -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                  <div class="card-header bg-white py-3 border-bottom">
                    <span class="badge bg-warning text-dark me-2">SECTION 1</span>
                    <strong class="text-dark">Operator Personal Details & Identification</strong>
                  </div>
                  <div class="card-body p-4">
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label fw-semibold" for="id_full_name">Full Name of Trader <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="id_full_name" name="full_name" placeholder="e.g. Fatuma Ahmed Ali" required />
                      </div>
                      <div class="col-md-3">
                        <label class="form-label fw-semibold" for="id_gender">Gender <span class="text-danger">*</span></label>
                        <select class="form-select" id="id_gender" name="gender" required>
                          <option value="FEMALE">Female</option>
                          <option value="MALE">Male</option>
                        </select>
                      </div>
                      <div class="col-md-3">
                        <label class="form-label fw-semibold" for="id_age">Age <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="id_age" name="age" min="16" max="120" value="28" required />
                      </div>

                      <div class="col-md-6">
                        <label class="form-label fw-semibold" for="id_national_id_resident_id">National ID / Resident ID No</label>
                        <input type="text" class="form-control font-monospace" id="id_national_id_resident_id" name="national_id_resident_id" placeholder="e.g. ET-HR-2024-99812 or Fayda ID" />
                      </div>
                      <div class="col-md-6">
                        <label class="form-label fw-semibold" for="id_phone_number">Phone Number <span class="text-danger">*</span></label>
                        <input type="tel" class="form-control" id="id_phone_number" name="phone_number" placeholder="e.g. +251 91 523 4819" required />
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Section 2: Operating Location -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                  <div class="card-header bg-white py-3 border-bottom">
                    <span class="badge bg-warning text-dark me-2">SECTION 2</span>
                    <strong class="text-dark">Trading Location (Harari Region)</strong>
                  </div>
                  <div class="card-body p-4">
                    <div class="row g-3">
                      <div class="col-md-3">
                        <label class="form-label fw-semibold" for="id_region">Region</label>
                        <input type="text" class="form-control" id="id_region" name="region" value="Harari Region" readonly />
                      </div>
                      <div class="col-md-4">
                        <label class="form-label fw-semibold" for="id_woreda">Woreda <span class="text-danger">*</span></label>
                        <select class="form-select" id="id_woreda" name="woreda" required>
                          <option value="">-- Select Woreda --</option>
                          <% woredas.forEach(w => { %>
                            <option value="<%= w.id %>"><%= w.name %> (<%= w.code %>)</option>
                          <% }); %>
                        </select>
                      </div>
                      <div class="col-md-5">
                        <label class="form-label fw-semibold" for="id_kebele">Kebele <span class="text-danger">*</span></label>
                        <select class="form-select" id="id_kebele" name="kebele" required>
                          <option value="">-- Select Woreda First --</option>
                        </select>
                      </div>

                      <div class="col-12">
                        <label class="form-label fw-semibold" for="id_specific_location_market_area">Specific Location / Market Area <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="id_specific_location_market_area" name="specific_location_market_area" placeholder="e.g. Gidir Magala (Open Vegetable Section, Stall 14) or Shoa Gate" required />
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Section 3: Activity & Capital -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                  <div class="card-header bg-white py-3 border-bottom">
                    <span class="badge bg-warning text-dark me-2">SECTION 3</span>
                    <strong class="text-dark">Activity Nature & Economic Profile</strong>
                  </div>
                  <div class="card-body p-4">
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label fw-semibold" for="id_nature_of_trade_activity">Nature of Trade Activity <span class="text-danger">*</span></label>
                        <select class="form-select" id="id_nature_of_trade_activity" name="nature_of_trade_activity" required>
                          <option value="STREET_VENDING_OPEN_MARKET">Street Vending / Open Market</option>
                          <option value="PETTY_RETAIL">Petty Retail (Corner Kiosk, Table Stand)</option>
                          <option value="HANDCRAFT_INFORMAL_PRODUCTION">Handcraft / Informal Production</option>
                          <option value="OTHER">Other</option>
                        </select>
                      </div>

                      <div class="col-md-6">
                        <label class="form-label fw-semibold" for="id_estimated_capital_assets">Estimated Capital / Assets (ETB) <span class="text-danger">*</span></label>
                        <div class="input-group">
                          <span class="input-group-text">ETB</span>
                          <input type="number" step="0.01" min="0" class="form-control" id="id_estimated_capital_assets" name="estimated_capital_assets" placeholder="e.g. 35000.00" value="30000.00" required />
                        </div>
                      </div>

                      <div class="col-12">
                        <label class="form-label fw-semibold" for="id_reason_for_operating_informally">Primary Reason for Operating Informally <span class="text-danger">*</span></label>
                        <select class="form-select" id="id_reason_for_operating_informally" name="reason_for_operating_informally" required>
                          <option value="LACK_OF_CAPITAL">Lack of Working Capital / Finance Access</option>
                          <option value="COMPLEX_BUREAUCRACY">Complex Registration Bureaucracy & Regulations</option>
                          <option value="TEMPORARY_SEASONAL_ACTIVITY">Temporary or Seasonal Activity</option>
                          <option value="OTHER">Other / Lack of Awareness</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Section 4: Formalization Recommendation -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                  <div class="card-header bg-white py-3 border-bottom">
                    <span class="badge bg-warning text-dark me-2">SECTION 4</span>
                    <strong class="text-dark">Enumerator Assessment & Formalization Recommendation</strong>
                  </div>
                  <div class="card-body p-4">
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label fw-semibold" for="id_enumerator_data_collector_name">Enumerator / Data Collector Name</label>
                        <input type="text" class="form-control" id="id_enumerator_data_collector_name" name="enumerator_data_collector_name" value="<%= user.first_name %> <%= user.last_name %>" />
                      </div>
                      <div class="col-md-6">
                        <label class="form-label fw-semibold" for="id_date_of_assessment">Date of Assessment <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="id_date_of_assessment" name="date_of_assessment" value="<%= new Date().toISOString().substring(0, 10) %>" required />
                      </div>

                      <div class="col-12">
                        <label class="form-label fw-semibold text-success" for="id_formalization_status_recommendation">
                          <i class="bi bi-star-fill text-warning me-1"></i>Formalization Recommendation <span class="text-danger">*</span>
                        </label>
                        <select class="form-select form-select-lg border-success" id="id_formalization_status_recommendation" name="formalization_status_recommendation" required>
                          <option value="READY_FOR_TIN_MICRO_ENTERPRISE">Ready for TIN & Micro-Enterprise Registration (High Priority)</option>
                          <option value="NEEDS_AWARENESS_LEGAL_SUPPORT">Needs Awareness / Legal Support (Capacity Building)</option>
                          <option value="FOLLOW_UP_REQUIRED">Follow-up Required (Secondary verification)</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Workflow Actions: Save Draft vs Submit -->
                <div class="d-flex justify-content-between align-items-center mb-5">
                  <a href="/traders/register/" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back
                  </a>
                  <div class="d-flex gap-2">
                    <button type="submit" name="submit_action" value="draft" class="btn btn-outline-secondary px-4 py-2 fw-semibold">
                      <i class="bi bi-save me-1"></i> Save as Draft
                    </button>
                    <button type="submit" name="submit_action" value="submit" class="btn btn-warning px-5 py-2 fw-semibold shadow-sm text-dark">
                      <i class="bi bi-send-check me-1"></i> Submit for Verification
                    </button>
                  </div>
                </div>
              </form>

            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>
