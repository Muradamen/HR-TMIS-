<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Trader Profile ' + trader.trader_code }) %>
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
  <div class="app-wrapper">
    <%- include('../partials/navbar') %>
    <%- include('../partials/sidebar', { activeNav: 'traders', activeSubNav: '' }) %>

    <main class="app-main">
      <div class="app-content-header py-3 bg-body border-bottom mb-4 no-print">
        <div class="container-fluid">
          <div class="row align-items-center g-2">
            <div class="col-sm-7">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <h3 class="mb-0 fw-bold text-body font-monospace"><%= trader.trader_code %></h3>
                <span class="badge <%= trader.trader_type === 'LEGAL' ? 'badge-legal' : 'badge-informal' %> fs-6">
                  <%= trader.trader_type %> TRADER
                </span>

                <% if (trader.status === 'APPROVED') { %>
                  <span class="badge badge-approved fs-6"><i class="bi bi-patch-check-fill me-1"></i>Approved</span>
                <% } else if (trader.status === 'SUBMITTED') { %>
                  <span class="badge bg-primary fs-6"><i class="bi bi-send-check me-1"></i>Submitted</span>
                <% } else if (trader.status === 'UNDER_REVIEW') { %>
                  <span class="badge bg-warning text-dark fs-6"><i class="bi bi-hourglass-split me-1"></i>Under Review</span>
                <% } else if (trader.status === 'NEEDS_CORRECTION') { %>
                  <span class="badge bg-danger fs-6"><i class="bi bi-pencil-square me-1"></i>Needs Correction</span>
                <% } else if (trader.status === 'DRAFT') { %>
                  <span class="badge bg-secondary fs-6"><i class="bi bi-file-earmark me-1"></i>Draft</span>
                <% } else if (trader.status === 'REJECTED') { %>
                  <span class="badge bg-dark fs-6"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                <% } else { %>
                  <span class="badge bg-secondary fs-6"><%= trader.status %></span>
                <% } %>
              </div>
              <p class="text-muted small mb-0 mt-1">
                Harari Region Official Registry Record &bull; Created: <%= trader.created_at.substring(0, 10) %> by <strong><%= trader.registered_by %></strong>
              </p>
            </div>
            <div class="col-sm-5 text-sm-end mt-2 mt-sm-0 d-flex justify-content-sm-end gap-2 flex-wrap">
              <!-- PDF Download Button -->
              <a href="/traders/<%= trader.trader_code %>/export/pdf" class="btn btn-outline-danger" title="Download Official Certificate PDF">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> PDF Certificate
              </a>
              <button onclick="window.print()" class="btn btn-outline-secondary">
                <i class="bi bi-printer me-1"></i> Print Dossier
              </button>
              <a href="/traders/" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left me-1"></i> Registry
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="app-content">
        <div class="container-fluid">

          <!-- Flash Message Notification -->
          <% if (typeof flashMessage !== 'undefined' && flashMessage) { %>
            <div class="alert alert-success alert-dismissible fade show shadow-sm no-print" role="alert">
              <i class="bi bi-check-circle-fill me-2"></i><%= flashMessage %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show shadow-sm no-print" role="alert">
              <i class="bi bi-shield-x me-2"></i><%= error %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <!-- Correction Alert Banner (If in Needs Correction state) -->
          <% if (trader.status === 'NEEDS_CORRECTION' && trader.correction_notes) { %>
            <div class="alert alert-warning border-warning d-flex align-items-center mb-4 shadow-sm" role="alert">
              <i class="bi bi-exclamation-triangle-fill fs-2 text-warning me-3"></i>
              <div>
                <strong class="d-block">Director Requested Corrections:</strong>
                <span><%= trader.correction_notes %></span>
              </div>
            </div>
          <% } %>

          <div class="row g-4">
            <!-- Left Column: Dossier Particulars -->
            <div class="col-lg-8">
              <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-body py-3 border-bottom d-flex justify-content-between align-items-center">
                  <h5 class="card-title fw-bold mb-0">
                    <i class="bi bi-file-earmark-text text-success me-2"></i>Registration Dossier
                  </h5>
                  <span class="font-monospace text-muted small"><%= trader.trader_code %></span>
                </div>
                <div class="card-body p-4">
                  <% if (trader.trader_type === 'LEGAL' && trader.legal_details) { %>
                    <!-- Legal Trader Particulars -->
                    <div class="row g-3">
                      <div class="col-12">
                        <div class="form-section-title">Commercial & Legal Particulars</div>
                      </div>
                      <div class="col-sm-6">
                        <div class="text-muted small">Trade / Entity Name</div>
                        <div class="fw-bold fs-5 text-primary"><%= trader.legal_details.trade_name %></div>
                      </div>
                      <div class="col-sm-6">
                        <div class="text-muted small">Owner Full Name</div>
                        <div class="fw-bold fs-5"><%= trader.legal_details.owner_full_name %></div>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">TIN (Taxpayer ID)</div>
                        <div class="font-monospace fw-semibold"><%= trader.legal_details.tin %></div>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">Trade Registration Number</div>
                        <div class="font-monospace fw-semibold"><%= trader.legal_details.trade_registration_number %></div>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">Trade License Number</div>
                        <div class="font-monospace fw-semibold text-success"><%= trader.legal_details.trade_license_number || 'N/A' %></div>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">Gender</div>
                        <div><%= trader.legal_details.gender %></div>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">Age</div>
                        <div><%= trader.legal_details.age %> years</div>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">Ownership Type</div>
                        <div><%= trader.legal_details.business_ownership_type.replace(/_/g, ' ') %></div>
                      </div>

                      <div class="col-12 mt-4">
                        <div class="form-section-title">Trade Sector & Municipal Location</div>
                      </div>
                      <div class="col-sm-6">
                        <div class="text-muted small">Business Sector</div>
                        <span class="badge bg-body-secondary text-body border fs-6">
                          <%= trader.legal_details.business_sector.replace(/_/g, ' ') %>
                        </span>
                      </div>
                      <div class="col-sm-6">
                        <div class="text-muted small">Trade Scale</div>
                        <span class="badge bg-secondary fs-6"><%= trader.legal_details.trade_scale %></span>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">Region</div>
                        <div><%= trader.legal_details.region %></div>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">Woreda</div>
                        <div class="fw-semibold"><%= trader.woredaName || 'N/A' %></div>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">Kebele & Plot ID</div>
                        <div class="fw-semibold"><%= trader.kebeleName || 'N/A' %> (<%= trader.legal_details.house_number_plot_id || 'Plot N/A' %>)</div>
                      </div>

                      <div class="col-12 mt-4">
                        <div class="form-section-title">Licensing & Administration</div>
                      </div>
                      <div class="col-sm-6">
                        <div class="text-muted small">Issuing Institution</div>
                        <div><%= trader.legal_details.issuing_institution %></div>
                      </div>
                      <div class="col-sm-6">
                        <div class="text-muted small">Date of Issuance</div>
                        <div><%= trader.legal_details.date_of_issuance %></div>
                      </div>
                      <div class="col-sm-6">
                        <div class="text-muted small">Registered By / Data Entered By</div>
                        <div><%= trader.registered_by %> (<%= trader.legal_details.data_entered_by %>)</div>
                      </div>
                      <div class="col-sm-6">
                        <div class="text-muted small">Official Verifier</div>
                        <div class="fw-semibold text-success"><%= trader.verified_by || 'Pending Review' %></div>
                      </div>
                      <% if (trader.legal_details.remarks) { %>
                        <div class="col-12">
                          <div class="text-muted small">Remarks & License Conditions</div>
                          <div class="p-3 bg-light rounded border"><%= trader.legal_details.remarks %></div>
                        </div>
                      <% } %>
                    </div>
                  <% } else if (trader.informal_details) { %>
                    <!-- Informal Trader Particulars -->
                    <div class="row g-3">
                      <div class="col-12">
                        <div class="form-section-title">Vendor Profile & Identification</div>
                      </div>
                      <div class="col-sm-6">
                        <div class="text-muted small">Full Name of Operator</div>
                        <div class="fw-bold fs-5 text-warning"><%= trader.informal_details.full_name %></div>
                      </div>
                      <div class="col-sm-6">
                        <div class="text-muted small">Phone Contact</div>
                        <div class="fw-semibold fs-5"><%= trader.informal_details.phone_number || 'N/A' %></div>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">Gender</div>
                        <div><%= trader.informal_details.gender %></div>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">Age</div>
                        <div><%= trader.informal_details.age %> years</div>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">National / Resident ID</div>
                        <div class="font-monospace"><%= trader.informal_details.national_id_resident_id || 'Not recorded' %></div>
                      </div>

                      <div class="col-12 mt-4">
                        <div class="form-section-title">Market Location & Operating Area</div>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">Region</div>
                        <div><%= trader.informal_details.region %></div>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">Woreda</div>
                        <div class="fw-semibold"><%= trader.woredaName || 'N/A' %></div>
                      </div>
                      <div class="col-sm-4">
                        <div class="text-muted small">Kebele</div>
                        <div class="fw-semibold"><%= trader.kebeleName || 'N/A' %></div>
                      </div>
                      <div class="col-12">
                        <div class="text-muted small">Specific Market Location</div>
                        <div class="p-2 bg-light rounded border fw-semibold">
                          <i class="bi bi-geo-alt-fill text-danger me-1"></i><%= trader.informal_details.specific_location_market_area %>
                        </div>
                      </div>

                      <div class="col-12 mt-4">
                        <div class="form-section-title">Economic Activity & Formalization Pathway</div>
                      </div>
                      <div class="col-sm-6">
                        <div class="text-muted small">Trade Activity Nature</div>
                        <span class="badge bg-body-secondary text-body border fs-6">
                          <%= trader.informal_details.nature_of_trade_activity.replace(/_/g, ' ') %>
                        </span>
                      </div>
                      <div class="col-sm-6">
                        <div class="text-muted small">Estimated Working Capital</div>
                        <div class="fw-bold fs-5 text-success">
                          ETB <%= Number(trader.informal_details.estimated_capital_assets).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
                        </div>
                      </div>
                      <div class="col-12">
                        <div class="text-muted small">Stated Driver for Operating Informally</div>
                        <div class="p-2 bg-body-secondary rounded border">
                          <%= trader.informal_details.reason_for_operating_informally.replace(/_/g, ' ') %>
                        </div>
                      </div>

                      <div class="col-12 mt-3">
                        <div class="p-3 bg-warning bg-opacity-10 border border-warning rounded-3">
                          <div class="d-flex align-items-center mb-1">
                            <i class="bi bi-star-fill text-warning fs-5 me-2"></i>
                            <h6 class="fw-bold mb-0 text-body">Formalization Recommendation</h6>
                          </div>
                          <div class="fs-6 fw-semibold text-body mt-1">
                            <%= trader.informal_details.formalization_status_recommendation.replace(/_/g, ' ') %>
                          </div>
                          <small class="text-muted">
                            Surveyed by <strong><%= trader.informal_details.enumerator_data_collector_name || trader.registered_by %></strong> on <%= trader.informal_details.date_of_assessment %>.
                          </small>
                        </div>
                      </div>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Right Column: Workflow Action Panel & Certificate Badge -->
            <div class="col-lg-4">
              <!-- WORKFLOW & VERIFICATION ACTION CARD (no-print) -->
              <div class="card border-0 shadow-sm rounded-3 mb-4 no-print">
                <div class="card-header bg-body py-3 border-bottom d-flex justify-content-between align-items-center">
                  <h6 class="fw-bold mb-0 text-body">
                    <i class="bi bi-shield-check text-primary me-2"></i>Workflow Actions
                  </h6>
                  <span class="badge bg-body-secondary text-body border"><%= user.role.replace(/_/g, ' ') %></span>
                </div>
                <div class="card-body p-3">

                  <!-- SELF-APPROVAL SECURITY WARNING -->
                  <% const isSelfRegistered = trader.registered_by.toLowerCase() === user.username.toLowerCase(); %>
                  <% if (isSelfRegistered && (user.role === 'DIRECTOR_OF_TRADER_CONTROL' || user.role === 'ADMINISTRATOR')) { %>
                    <div class="alert alert-danger py-2 px-3 small mb-3">
                      <i class="bi bi-shield-exclamation me-1 fw-bold"></i>
                      <strong>Self-Approval Blocked:</strong> You registered this record (<%= trader.registered_by %>). Internal control policy requires an independent Director to approve it.
                    </div>
                  <% } %>

                  <!-- Director Review Actions -->
                  <% if (user.role === 'DIRECTOR_OF_TRADER_CONTROL' || user.role === 'ADMINISTRATOR') { %>
                    <% if (['SUBMITTED', 'UNDER_REVIEW', 'NEEDS_CORRECTION'].includes(trader.status)) { %>
                      <form action="/traders/<%= trader.trader_code %>/transition" method="POST" class="mb-3">
                        <div class="mb-3">
                          <label class="form-label small fw-semibold">Action Decision:</label>
                          <select name="target_status" class="form-select" id="decision_select" required>
                            <% if (trader.status === 'SUBMITTED') { %>
                              <option value="UNDER_REVIEW">Move to Under Review</option>
                            <% } %>
                            <% if (!isSelfRegistered) { %>
                              <option value="APPROVED">Approve Registration</option>
                            <% } %>
                            <option value="NEEDS_CORRECTION">Request Correction</option>
                            <option value="REJECTED">Reject Application</option>
                          </select>
                        </div>

                        <div class="mb-3" id="notes_container">
                          <label class="form-label small fw-semibold" for="action_notes">Notes / Correction Instructions / Reason:</label>
                          <textarea class="form-control" name="notes" id="action_notes" rows="2" placeholder="Required if requesting correction or rejecting"></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-semibold">
                          <i class="bi bi-check2-circle me-1"></i> Apply Decision
                        </button>
                      </form>
                    <% } else if (trader.status === 'APPROVED') { %>
                      <div class="alert alert-success py-2 px-3 small mb-2">
                        <i class="bi bi-patch-check-fill me-1"></i> This trader is approved and verified by <strong><%= trader.verified_by %></strong>.
                      </div>
                    <% } else if (trader.status === 'DRAFT') { %>
                      <div class="alert alert-secondary py-2 px-3 small mb-2">
                        <i class="bi bi-info-circle me-1"></i> This record is in Draft status. The Data Encoder must submit it before it enters the verification queue.
                      </div>
                    <% } %>
                  <% } %>

                  <!-- Data Encoder Actions (Submit Draft or Resubmit Correction) -->
                  <% if (user.role === 'DATA_ENCODER' || user.role === 'ADMINISTRATOR') { %>
                    <% if (['DRAFT', 'NEEDS_CORRECTION'].includes(trader.status)) { %>
                      <form action="/traders/<%= trader.trader_code %>/transition" method="POST" class="mt-2">
                        <input type="hidden" name="target_status" value="SUBMITTED" />
                        <button type="submit" class="btn btn-success w-100 fw-semibold">
                          <i class="bi bi-send-check me-1"></i> Submit Record for Review
                        </button>
                      </form>
                    <% } %>
                  <% } %>

                  <!-- Administrator Archive Action -->
                  <% if (user.role === 'ADMINISTRATOR' && trader.status !== 'ARCHIVED') { %>
                    <form action="/traders/<%= trader.trader_code %>/transition" method="POST" class="mt-3 border-top pt-2">
                      <input type="hidden" name="target_status" value="ARCHIVED" />
                      <button type="submit" class="btn btn-sm btn-outline-danger w-100" onclick="return confirm('Are you sure you want to archive this record?')">
                        <i class="bi bi-archive me-1"></i> Archive Record (Admin)
                      </button>
                    </form>
                  <% } %>

                </div>
              </div>

              <!-- Certificate Preview Card with PDF link -->
              <div class="card border border-2 border-success shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-harari py-2 px-3 text-white text-center">
                  <div class="fw-bold small tracking-wide text-uppercase">Harari Regional State</div>
                  <div class="small opacity-90">Trade & Industry Bureau Certificate</div>
                </div>
                <div class="card-body p-3 text-center">
                  <div class="mb-2">
                    <i class="bi bi-patch-check-fill fs-1 text-success"></i>
                  </div>
                  <h5 class="fw-bold mb-1">
                    <%= trader.trader_type === 'LEGAL' ? trader.legal_details.trade_name : trader.informal_details.full_name %>
                  </h5>
                  <div class="font-monospace text-success fw-bold fs-6 mb-2">
                    <%= trader.trader_code %>
                  </div>

                  <div class="p-2 bg-body-secondary rounded text-start small mb-3 border">
                    <div class="d-flex justify-content-between mb-1">
                      <span class="text-muted">Type:</span>
                      <strong><%= trader.trader_type %></strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                      <span class="text-muted">Woreda:</span>
                      <strong><%= trader.woredaName %></strong>
                    </div>
                    <div class="d-flex justify-content-between">
                      <span class="text-muted">Workflow Status:</span>
                      <strong class="text-uppercase"><%= trader.status.replace(/_/g, ' ') %></strong>
                    </div>
                  </div>

                  <a href="/traders/<%= trader.trader_code %>/export/pdf" class="btn btn-sm btn-success w-100 fw-semibold mb-1">
                    <i class="bi bi-file-earmark-pdf me-1"></i> Download PDF Certificate
                  </a>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>
