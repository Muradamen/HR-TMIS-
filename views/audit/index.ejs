<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Audit Trail' }) %>
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
  <div class="app-wrapper">
    <%- include('../partials/navbar') %>
    <%- include('../partials/sidebar', { activeNav: 'audit', activeSubNav: '' }) %>

    <main class="app-main">
      <div class="app-content-header py-3 bg-body border-bottom mb-4">
        <div class="container-fluid">
          <div class="row align-items-center g-2">
            <div class="col-sm-6">
              <h3 class="mb-0 fw-bold text-body">
                <i class="bi bi-clock-history text-secondary me-2"></i>System Audit Trail
              </h3>
              <p class="text-muted small mb-0">Immutable tracking of registrations, status transitions, verifications, and regulatory activities</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
              <a href="/traders/" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Registry
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="app-content">
        <div class="container-fluid">
          <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-body py-3 d-flex justify-content-between align-items-center">
              <h5 class="card-title fw-bold mb-0">
                Regulatory Action Log (<%= logs.length %> Records)
              </h5>
              <span class="small text-muted"><i class="bi bi-shield-check text-success me-1"></i>Append-Only Logging Active</span>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th style="width: 70px;">Log ID</th>
                      <th>Timestamp</th>
                      <th>Action Event</th>
                      <th>Target Record</th>
                      <th>User Actor</th>
                      <th>Client IP Address</th>
                      <th>Event Details</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% logs.forEach(log => { %>
                      <tr>
                        <td class="text-muted font-monospace"><%= log.id %></td>
                        <td class="font-monospace small"><%= log.timestamp %></td>
                        <td>
                          <% if (log.action.includes('APPROVED')) { %>
                            <span class="badge bg-success"><%= log.action %></span>
                          <% } else if (log.action.includes('SUBMITTED')) { %>
                            <span class="badge bg-primary"><%= log.action %></span>
                          <% } else if (log.action.includes('CORRECTION')) { %>
                            <span class="badge bg-danger"><%= log.action %></span>
                          <% } else if (log.action.includes('REJECTED')) { %>
                            <span class="badge bg-dark"><%= log.action %></span>
                          <% } else { %>
                            <span class="badge bg-secondary"><%= log.action %></span>
                          <% } %>
                        </td>
                        <td>
                          <% if (log.target_id && log.target_id.startsWith('HT-')) { %>
                            <a href="/traders/<%= log.target_id %>/" class="font-monospace fw-bold text-decoration-none">
                              <%= log.target_id %>
                            </a>
                          <% } else { %>
                            <span class="font-monospace text-muted"><%= log.target_id %></span>
                          <% } %>
                        </td>
                        <td>
                          <span class="badge bg-body-secondary text-body border">
                            <i class="bi bi-person me-1"></i><%= log.user %>
                          </span>
                        </td>
                        <td>
                          <span class="font-monospace text-muted small"><%= log.ip_address || '127.0.0.1' %></span>
                        </td>
                        <td class="small"><%= log.details %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>
