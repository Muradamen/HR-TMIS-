# HT-TMIS Environment Variables

# Django REST Framework Backend Configuration
DJANGO_SECRET_KEY=django-insecure-hr-tmis-development-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database: PostgreSQL (defaults to SQLite if DATABASE_URL is not set)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrtmis

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
