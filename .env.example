# React/Vite frontend
VITE_API_BASE_URL=/api/v1
PORT=3000

# Django backend - required for production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.example,localhost,127.0.0.1
DATABASE_URL=postgresql://ht_tmis_user:replace-me@127.0.0.1:5432/ht_tmis
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer
CORS_ALLOWED_ORIGINS=https://your-domain.example,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-domain.example,http://localhost:3000
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_AGE=1800

# Never commit real credentials or production secrets to source control.
